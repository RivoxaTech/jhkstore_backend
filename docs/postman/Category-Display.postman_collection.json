{
  "info": {
    "_postman_id": "b7c3e9a2-5d14-4f6e-8a21-3c9d0e7f4b52",
    "name": "Category Display",
    "description": "Customer APIs to DISPLAY categories. Public, no login. Just press Send. Variable base_url = http://localhost:8000/api/v1\n\nStructure: category > sub_categories > children (only some sub-categories have children). Only active items are returned, already sorted.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. All categories (tree)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Has categories', () => pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Every active category with its sub_categories, and each sub-category with its children (sub-sub-categories). Use for the category page and the menu. A sub-category with children: [] has no dropdown - it goes straight to its products. icon_url / image_url are absolute URLs or null.",
        "url": {
          "raw": "{{base_url}}/store/categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "categories"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Top categories (home screen)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('At most 12', () => pm.expect(pm.response.json().data.length).to.be.at.most(12));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Only the top categories (maximum 12) chosen in the admin panel, in order. Use for the home screen tiles: name, slug, icon_url, image_url.",
        "url": {
          "raw": "{{base_url}}/store/categories?top=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "categories"
          ],
          "query": [
            {
              "key": "top",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. One category (with sub-categories and children)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Has children', () => pm.expect(pm.response.json().data.sub_categories[0].children).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "One category by its slug. Orthodontics has sub-sub-categories under Brackets and Wires. Change the slug in the URL to try another one (endodontics, equipments, ...).",
        "url": {
          "raw": "{{base_url}}/store/categories/orthodontics",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "categories",
            "orthodontics"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Unknown or inactive category (404 example)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Shows what the API returns for a slug that does not exist or whose category is inactive: HTTP 404.",
        "url": {
          "raw": "{{base_url}}/store/categories/no-such-category",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "categories",
            "no-such-category"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    }
  ]
}
