{
  "info": {
    "_postman_id": "b7c9e2d4-5a1f-4e36-8d02-3f6a9c1e7b45",
    "name": "Dentalkart Products - Frontend",
    "description": "Product APIs for the frontend: product lists (homepage sections, filters, search, sorts, paging, Instadent), product pages (single option / several options), tags and reviews. Categories and brands are in the other collections.\n\nSetup: run \"php artisan migrate:fresh --seed\" and \"php artisan db:seed --class=ProductDemoSeeder\", start \"php artisan serve\", then just press Send. Variables: base_url = http://localhost:8000/api/v1 ; customer_token is filled by \"1. Customer login\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "single_option_slug",
      "value": "dentaltech-scan-body-nobel-biocare-np-implant-compatible",
      "type": "string"
    },
    {
      "key": "multi_option_slug",
      "value": "dentaltech-prosthetic-hex-drivers-straumann-implant-compatible",
      "type": "string"
    },
    {
      "key": "two_option_slug",
      "value": "dentaltech-disposable-transfer-coping-osstem-mini-implant-compatible-pack-of-10",
      "type": "string"
    },
    {
      "key": "reviewed_slug",
      "value": "prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Customer login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.token) { pm.collectionVariables.set('customer_token', j.token); }",
              "pm.test('token saved in customer_token', () => pm.expect(j.token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Only needed for \"Instadent\" requests and for posting a review. The token is saved into the collection variable customer_token automatically.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"test@gmail.com\",\n  \"password\": \"test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/store/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "auth",
            "login"
          ],
          "query": []
        }
      },
      "response": []
    },
