{
  "info": {
    "name": "Store API (customer side)",
    "description": "Customer API of the e-commerce base. Run the requests top to bottom against a database seeded with `php artisan migrate:fresh --seed` and `php artisan db:seed --class=DemoSeeder`. The scripts save variant_id, cart_token, customer_token, address_id and order_number. See docs/STOREFRONT-API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Store settings (start here)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/settings"
      }
    },
    {
      "name": "2. Banners of a placement (home_hero: one banner or a slider)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/banners?placement=home_hero"
      }
    },
    {
      "name": "3. Banners: promo strip",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/banners?placement=promo_strip"
      }
    },
    {
      "name": "4. Categories (tree, 2 levels)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/categories"
      }
    },
    {
      "name": "5. Top categories (home screen)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/categories?top=1"
      }
    },
    {
      "name": "6. Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products?per_page=12&sort=popularity"
      }
    },
    {
      "name": "7. Home section by tag",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products?tag=best-seller&per_page=10"
      }
    },
    {
      "name": "8. Search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products?q=headphones"
      }
    },
    {
      "name": "9. Product detail (saves variant_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json().data;",
              "if (d && d.variants && d.variants.length) { pm.collectionVariables.set('variant_id', d.variants[0].id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products/wireless-headphones"
      }
    },
    {
      "name": "10. Guest: add to cart (saves cart_token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t = pm.response.json().data.token;",
              "if (t) { pm.collectionVariables.set('cart_token', t); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variant_id\": \"{{variant_id}}\",\n  \"qty\": 2\n}"
        },
        "url": "{{base_url}}/cart/items"
      }
    },
    {
      "name": "11. Guest: show cart",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-Cart-Token",
            "value": "{{cart_token}}"
          }
        ],
        "url": "{{base_url}}/cart"
      }
    },
    {
      "name": "12. Login (merges the guest cart, saves customer_token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('customer_token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Cart-Token",
            "value": "{{cart_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"demo@example.com\",\n  \"password\": \"demo-password\"\n}"
        },
        "url": "{{base_url}}/auth/login"
      }
    },
    {
      "name": "13. Customer: show cart",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/cart"
      }
    },
    {
      "name": "14. Customer: change quantity",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"qty\": 3\n}"
        },
        "url": "{{base_url}}/cart/items/{{variant_id}}"
      }
    },
    {
      "name": "15. Addresses (saves address_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json().data;",
              "if (d && d.length) { pm.collectionVariables.set('address_id', d[0].id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/addresses"
      }
    },
    {
      "name": "16. Place order (cash on delivery)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d = pm.response.json().data;",
              "if (d) { pm.collectionVariables.set('order_number', d.order_number); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address_id\": \"{{address_id}}\",\n  \"customer_note\": \"Please call before delivery\"\n}"
        },
        "url": "{{base_url}}/orders"
      }
    },
    {
      "name": "17. My orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/orders"
      }
    },
    {
      "name": "18. Order detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/orders/{{order_number}}"
      }
    },
    {
      "name": "19. Cancel order (before it ships)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
        },
        "url": "{{base_url}}/orders/{{order_number}}/cancel"
      }
    },
    {
      "name": "20. Reorder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{customer_token}}",
              "type": "string"
            }
          ]
        },
        "url": "{{base_url}}/orders/{{order_number}}/reorder"
      }
    },
    {
      "name": "21. Reviews of a product",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products/wireless-headphones/reviews"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1/store"
    },
    {
      "key": "variant_id",
      "value": ""
    },
    {
      "key": "cart_token",
      "value": ""
    },
    {
      "key": "customer_token",
      "value": ""
    },
    {
      "key": "address_id",
      "value": ""
    },
    {
      "key": "order_number",
      "value": ""
    }
  ]
}
