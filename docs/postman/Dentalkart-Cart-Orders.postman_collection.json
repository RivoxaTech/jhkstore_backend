        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data && j.data.order_number) { pm.collectionVariables.set('order_number_2', j.data.order_number); }",
              "pm.test('order_number_2 saved', () => pm.expect(j.data.order_number).to.match(/^DK-\\d{4}-\\d{6}$/));"
            ]
          }
        }
