    {
      "name": "15. Addresses: create (saves address_id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "const v = j.data && j.data.id;",
              "if (v !== undefined && v !== null) { pm.collectionVariables.set('address_id', v); }",
              "pm.test('address_id saved', () => pm.expect(v).to.not.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_token}}"
          }
        ],
        "description": "The Dentalkart address form. line1 = clinic name / house no. / building / apartment, area = area / street / sector / village. Optional: alt_phone, landmark, gst_number (15-character GSTIN, validated), latitude + longitude, label. type = clinic | home | other. The first address becomes the default automatically. Validation errors come back as 422 with ready-to-show messages.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Asha Khan\",\n  \"phone\": \"0300 1234567\",\n  \"alt_phone\": \"0311 7654321\",\n  \"line1\": \"Smile Dental Clinic, Shop 4, Medicare Plaza\",\n  \"area\": \"Block B, Gulberg III\",\n  \"landmark\": \"Near the main boulevard\",\n  \"city\": \"Lahore\",\n  \"state\": \"Punjab\",\n  \"postcode\": \"54660\",\n  \"country\": \"Pakistan\",\n  \"gst_number\": \"27ABCDE1234F1Z5\",\n  \"type\": \"clinic\",\n  \"latitude\": 31.5204,\n  \"longitude\": 74.3587,\n  \"is_default\": false\n}",
