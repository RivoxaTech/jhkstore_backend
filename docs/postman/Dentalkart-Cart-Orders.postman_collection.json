          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "description": "Run it right after the request above: the same key returns the SAME order (status 200 and the header Idempotency-Replayed: true) instead of a second one, so a double tap or a network retry is safe.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"address_id\": \"{{address_id}}\",\n  \"payment_method\": \"cod\",\n  \"coins_to_redeem\": 100\n}",
          "options": {
