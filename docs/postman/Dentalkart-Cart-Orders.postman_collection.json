  "item": [
    {
      "name": "1. Guest: add an item to the cart (saves cart_token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data && j.data.token) { pm.collectionVariables.set('cart_token', j.data.token); }",
              "pm.test('cart_token saved', () => pm.expect(j.data.token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Cart-Token",
            "value": "{{cart_token}}"
          }
        ],
        "description": "No login needed. The first add creates a guest cart; the server answers with data.token (also in the X-Cart-Token response header) and the test script saves it into the variable cart_token. Every next guest request sends it as the X-Cart-Token header. variant_id is an OPTION (variant) of a product: 21 = Dentaltech Scan Body, which has bulk prices (Buy 2+ / 5+ / 10+ for less).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variant_id\": \"{{variant_id}}\",\n  \"qty\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/store/cart/items?channel=standard",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "cart",
            "items"
          ],
          "query": [
            {
              "key": "channel",
              "value": "standard"
            }
          ]
        }
      },
      "response": []
    },
