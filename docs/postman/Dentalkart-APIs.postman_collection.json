{
  "info": {
    "_postman_id": "d4a6b2c1-7e3f-4a58-9c10-6b2f8e5d1a33",
    "name": "Dentalkart APIs",
    "description": "Customer APIs: dropdown lists, register a company, brands, products (list, detail, tags, reviews). Categories are in Category-Display.postman_collection.json. Variables: base_url = http://localhost:8000/api/v1, customer_token = token of \"11. Customer login\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Registration types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Dropdown \"Company registered as\".",
        "url": {
          "raw": "{{base_url}}/store/lookups/registration-types",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "lookups",
            "registration-types"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. Vendor types",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Dropdown \"Vendor type\".",
        "url": {
          "raw": "{{base_url}}/store/lookups/vendor-types",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "lookups",
            "vendor-types"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Countries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Dropdown \"Origin country\".",
        "url": {
          "raw": "{{base_url}}/store/lookups/countries",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "lookups",
            "countries"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. All dropdowns in one call",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Registration types, vendor types and countries together, plus the form limits.",
        "url": {
          "raw": "{{base_url}}/store/company-registration/options",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "company-registration",
            "options"
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Register a company",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Company registration (the \"Sell on Dentalkart\" form). multipart/form-data. The company waits in the admin panel (Companies > Pending) for approval. A new name and GST number are used on every send.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Sunrise Dental Supplies {{$timestamp}}",
              "type": "text",
              "description": "required"
            },
            {
              "key": "registration_type_id",
              "value": "1",
              "type": "text",
              "description": "required - id from API 1"
            },
            {
              "key": "vendor_type_id",
              "value": "1",
              "type": "text",
              "description": "required - id from API 2"
            },
            {
              "key": "origin_country_id",
              "value": "1",
              "type": "text",
              "description": "required - id from API 3"
            },
            {
              "key": "email",
              "value": "info@sunrise-dental.test",
              "type": "text",
              "description": "required"
            },
            {
              "key": "contact_number",
              "value": "+91 9876543210",
              "type": "text",
              "description": "required"
            },
            {
              "key": "vat_gst_number",
              "value": "27{{$timestamp}}A1Z5",
              "type": "text",
              "description": "required - must be new"
            },
            {
              "key": "contact_name",
              "value": "Asha Rao",
              "type": "text",
              "description": "required"
            },
            {
              "key": "contact_mobile",
              "value": "9876543210",
              "type": "text",
              "description": "required"
            },
            {
              "key": "contact_email",
              "value": "asha@sunrise-dental.test",
              "type": "text",
              "description": "required"
            },
            {
              "key": "contact_whatsapp",
              "value": "9876543210",
              "type": "text",
              "description": "optional",
              "disabled": true
            },
            {
              "key": "address",
              "value": "12 Industrial Area, Phase 2",
              "type": "text",
              "description": "required"
            },
            {
              "key": "landmark",
              "value": "Near Metro Station",
              "type": "text",
              "description": "optional",
              "disabled": true
            },
            {
              "key": "city",
              "value": "New Delhi",
              "type": "text",
              "description": "required"
            },
            {
              "key": "zip_code",
              "value": "110074",
              "type": "text",
              "description": "required"
            },
            {
              "key": "promotion_support",
              "value": "We will support Dentalkart with prominent banner placement, launch discounts, free product samples, clinical demonstrations, webinars and dedicated training for the sales team. Our technical staff will also share brochures, videos and after-sales assistance for every dental clinic customer.",
              "type": "text",
              "description": "required - 200 to 500 characters"
            },
            {
              "key": "brands[0][name]",
              "value": "Sunrise Dental Care",
              "type": "text",
              "description": "required - at least one brand"
            },
            {
              "key": "brands[1][name]",
              "value": "Sunrise Ortho",
              "type": "text",
              "description": "optional - another brand (brands[2][name], ...)"
            },
            {
              "key": "brands[0][origin_country_id]",
              "value": "1",
              "type": "text",
              "description": "optional - brand country",
              "disabled": true
            },
            {
              "key": "logo",
              "type": "file",
              "src": "E:/usman/Detalkart/backend/docs/postman/sample-logo.png",
              "description": "required - company logo image (png, jpg, jpeg, webp, max 4 MB)"
            },
            {
              "key": "catalogue[]",
              "type": "file",
              "src": [],
              "description": "optional - private catalogue files",
              "disabled": true
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/store/company-registrations",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "company-registrations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Brands list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Brands to display on the website (active brands of approved companies).",
        "url": {
          "raw": "{{base_url}}/store/brands?per_page=30&page=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "brands"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "30"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "q",
              "value": "sunrise",
              "description": "search by name",
              "disabled": true
            },
            {
              "key": "collection",
              "value": "top",
              "description": "top | featured | new | suggested",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. Products list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_token}}",
            "disabled": true,
            "description": "needed for channel=instadent"
          }
        ],
        "description": "Product cards. The homepage sections are this call with a tag: best-seller, hot-selling, new-arrival, best-price-zone, featured, most-searched, freebie (see Tags). Switch on the other params to filter / sort. channel=instadent needs the Authorization header (a guest gets 401). Run \"php artisan db:seed --class=ProductDemoSeeder\" for demo products.",
        "url": {
          "raw": "{{base_url}}/store/products?tag=best-seller",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "products"
          ],
          "query": [
            {
              "key": "tag",
              "value": "best-seller",
              "description": "section: best-seller | hot-selling | new-arrival | best-price-zone | ..."
            },
            {
              "key": "category",
              "value": "restorative",
              "description": "category slug",
              "disabled": true
            },
            {
              "key": "sub_category",
              "value": "composites",
              "description": "sub-category slug",
              "disabled": true
            },
            {
              "key": "brand",
              "value": "waldent",
              "description": "brand slug (brand page)",
              "disabled": true
            },
            {
              "key": "q",
              "value": "composite",
              "description": "search",
              "disabled": true
            },
            {
              "key": "min_price",
              "value": "500",
              "disabled": true
            },
            {
              "key": "max_price",
              "value": "5000",
              "disabled": true
            },
            {
              "key": "in_stock",
              "value": "1",
              "disabled": true
            },
            {
              "key": "rating",
              "value": "4",
              "description": "4 = 4 stars and up",
              "disabled": true
            },
            {
              "key": "channel",
              "value": "instadent",
              "description": "standard (default) | instadent",
              "disabled": true
            },
            {
              "key": "sort",
              "value": "price_asc",
              "description": "popularity | newest | price_asc | price_desc | discount | rating",
              "disabled": true
            },
            {
              "key": "per_page",
              "value": "10",
              "description": "max 100",
              "disabled": true
            },
            {
              "key": "page",
              "value": "1",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "8. Product detail",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "One product page: description, content tabs, options (each with its own name, SKU, pictures, bulk prices and the channel stock), product gallery, delivery estimate (arrives_by), return days and related products. The slug comes from the products list. Prices are in PKR.",
        "url": {
          "raw": "{{base_url}}/store/products/prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "products",
            "prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes"
          ],
          "query": [
            {
              "key": "channel",
              "value": "instadent",
              "description": "standard (default) | instadent (needs a login)",
              "disabled": true
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "9. Tags",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Active tags. The slug is what ?tag= of the products list expects.",
        "url": {
          "raw": "{{base_url}}/store/tags",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "tags"
          ]
        }
      },
      "response": []
    },
    {
      "name": "10. Product reviews list",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": "Published reviews (newest first) and the summary: average, count and the 1-5 distribution.",
        "url": {
          "raw": "{{base_url}}/store/products/prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes/reviews?per_page=10&page=1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "products",
            "prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes",
            "reviews"
          ],
          "query": [
            {
              "key": "per_page",
              "value": "10",
              "description": "max 50"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "11. Customer login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Seed customer. Copy the \"token\" of the answer into the collection variable customer_token (used by request 12 and by channel=instadent).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"test@gmail.com\",\n  \"password\": \"test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/store/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "12. Post a review",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{customer_token}}"
          }
        ],
        "description": "Needs the customer token (request 11 -> variable customer_token). One review per customer and product: sending again updates it (200); the first one answers 201.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 5,\n  \"title\": \"Works well\",\n  \"body\": \"Good quality, delivered on time.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/store/products/prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes/reviews",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "store",
            "products",
            "prime-dent-hybrid-composite-restorative-kit-made-in-usa-7-x-45g-syringes",
            "reviews"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "customer_token",
      "value": "",
      "type": "string"
    }
  ]
}
