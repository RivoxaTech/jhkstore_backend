# Root ignore file. Each folder has its own: backend/.gitignore (vendor, .env, storage, the built admin panel), admin-frontend/.gitignore,
# frontend/.gitignore. This one catches what could appear anywhere.
.env
.env.*
!.env.example
node_modules/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
/shots/

# the help video maker's scratch files

# The other two repositories of the project live in these folders when they are cloned next to backend/ (see README.md): never part of this repository
/admin-frontend/
/frontend/
