APP_NAME="JHK Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002
# Shop time zone: "today", order dates and the date filters of the admin panel follow it
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jhkstore_db
DB_USERNAME=root
DB_PASSWORD=
# `php artisan serve` opens a new MySQL connection for every request (about 15 ms). Locally (APP_ENV=local) the connection is kept open between requests;
# on a real server leave it to PHP-FPM, or set DB_PERSISTENT=true to keep it open there too. (docs/PERFORMANCE.md)
# DB_PERSISTENT=false
# The tables are always InnoDB (transactions and row locks protect stock, coupons and orders); a host that defaults to MyISAM would otherwise fail the first migration (error 1071).
# DB_ENGINE=InnoDB

# Speed: on ONE server `file` for the sessions and the cache saves 6 to 10 database queries on every request of the panel (docs/PERFORMANCE.md).
# Keep `database` (or use redis) when several servers share the site.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# E-mails and push notifications are queued: QUEUE_CONNECTION=database needs a queue worker or a cron job (docs/NEW_CLIENT.md)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_MAILER=log writes e-mails to storage/logs/laravel.log (development). Use smtp in production; switch e-mails on in Settings > Notifications.

# Admin push notifications (Web Push): generate a key pair with `php artisan shop:vapid`, then switch push on in Settings > Notifications
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Product video uploads (KB, default 50 MB) and the poster picture. PHP upload_max_filesize and post_max_size must be at least this large.
PRODUCT_VIDEO_MAX_KB=51200
# PRODUCT_VIDEO_POSTER_MAX_KB=2048

# Wholesale request form: requests per hour per IP and per phone number
WHOLESALE_PER_HOUR=5
WHOLESALE_PER_PHONE_HOUR=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend origin(s) allowed by CORS (comma separated): the storefront (Nuxt dev server http://localhost:3000, then its real domain) and the admin panel dev server.
# Cloudflare Pages preview sites live on *.pages.dev: allow them with a pattern (a regular expression without commas, several separated by commas), e.g.
# FRONTEND_URL_PATTERNS=#^https://[a-z0-9-]+\.my-store\.pages\.dev$#
# The browser may read X-Cart-Token and Idempotency-Replayed from the answers (config/cors.php).
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5190,http://127.0.0.1:5190,http://localhost:3000,http://127.0.0.1:3000
# How long (seconds) the browser remembers the answer to the CORS preflight before our cart / quote / order calls. 7200 is the most Chrome keeps. Leave it unless you know why.
# CORS_MAX_AGE=7200
# The two admin accounts (seeders refuse weak passwords in production: 12+ characters, not equal to the username)
# developer = builds the site (never sees orders); admin = the client. Optional: SEED_DEVELOPER_NAME / _EMAIL, SEED_ADMIN_NAME / _EMAIL
SEED_DEVELOPER_USERNAME=developer
SEED_DEVELOPER_PASSWORD=developer
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# Origins that use the cookie (session) login: the admin panel. The storefront needs no login, so it is NOT listed.
SANCTUM_STATEFUL_DOMAINS=localhost:5190,127.0.0.1:5190,localhost:8000,127.0.0.1:8000,localhost:8002,127.0.0.1:8002

# Admin API token lifetime in minutes (0 = never expire). Scripts only; the panel uses the session cookie: 720 = 12 hours.
ADMIN_TOKEN_MINUTES=720

# Rate limits (requests per minute unless noted); the defaults are shown
# PUBLIC_PER_MINUTE=240
# ADMIN_PER_MINUTE=600
# QUOTE_PER_MINUTE=60
# CHECKOUT_PER_MINUTE=10
# CHECKOUT_PER_HOUR=60
# CHECKOUT_PER_PHONE_HOUR=10
# ORDER_LOOKUP_PER_MINUTE=20
# ORDER_LOOKUP_PER_ORDER_HOUR=15

# Checkout abuse limits and the hidden honeypot field name (see config/shop.php)
# SHOP_MAX_ITEMS_PER_ORDER=30
# SHOP_MAX_QTY_PER_LINE=500
# SHOP_HONEYPOT_FIELD=hp_extra   (not "website": browsers autofill that name)

# Cache headers of the public catalogue endpoints (seconds): browsers / Cloudflare / stale-while-revalidate. Cart, orders, quote, coupons and admin are never cached.
# STORE_CACHE_MAX_AGE=60
# STORE_CACHE_S_MAXAGE=300
# STORE_CACHE_SWR=60
